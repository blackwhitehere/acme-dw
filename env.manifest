# This file declares all env vars used by this package/application.
# It can be turned into an `.env` file by providing values for the declared env vars.
# Note that not all env vars need to be specified as code may include defaults for their values.

# S3 bucket name used by DW when no backend is injected explicitly.
DW_AWS_BUCKET_NAME=

# AWS region used by boto3/acme-s3 when building S3 clients.
AWS_DEFAULT_REGION=
# AWS named profile used by boto3 credential resolution.
AWS_PROFILE=
# AWS access key ID used for S3 authentication when not using profile/role auth.
AWS_ACCESS_KEY_ID=
# AWS secret access key paired with AWS_ACCESS_KEY_ID.
AWS_SECRET_ACCESS_KEY=
# AWS session token used for temporary credentials (STS/SSO).
AWS_SESSION_TOKEN=